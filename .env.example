# Copy to .env. Every value has a default; npm test needs none of them.

# OpenAI key. Absent key + LLM_MODE=live -> pipeline refuses to run.
OPENAI_API_KEY=

# live | replay. Only `live` is given a transport, so only `live` can spend money:
# in replay a cache miss is an error, whatever key is set here.
LLM_MODE=replay

# Model ids (ARCHITECTURE.md section 5)
MODEL_PIPELINE=gpt-6-luna
EMBED_MODEL=Xenova/multilingual-e5-small
# The upstream commit the committed index was built with; set to `main` for a different EMBED_MODEL.
EMBED_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78

# EMBED_OFFLINE=1 refuses to download the embedding model (118 MB into .model-cache/) and fails
# instead. Useful to prove a run is offline; leave unset for a normal first run.

# Judge cutoff on confidence (artifacts/calibration.json)
CUTOFF=0.6

# empty | tag   (Keychain confirmed empty is the correct answer, README question 2)
NON_MANUFACTURER_POLICY=empty

# Retrieval query text: name | name_quote | conditional (artifacts/query-mode-study.json)
QUERY_MODE=name

# Paths
SOURCE_DB=data/category_tagging.sqlite
ARTIFACTS_DIR=artifacts
